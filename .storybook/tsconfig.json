{
  "extends": "../tsconfig.app.json",
  "compilerOptions": {
    "types": [], 
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "emitDecoratorMetadata": true
  },
  "exclude": [
    "../src/test.ts",
    "../src/**/*.spec.ts",
    "../projects/**/*.spec.ts",
    "../src/**/*.spec.ts"
  ],
  "include": [
    "../src/**/*",
    "../projects/**/*", 
    "../src/**/*.component.ts"
  ],
  "files": [
    "./typings.d.ts"
  ]
}